{
    "manifest_version": 3,
    "name": "Extension Finder",
    "description":"This is a local system extention used to find extension numbers",
    "version": "1.0",
    "action": {
      "default_popup": "Index.html",
      "default_title": "Extension Person Finder"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["./scripts/script.js"]
      }
    ],
    "permissions": [
      "storage",
      "<all_urls>"
    ],
    "chrome_url_overrides": {},
    "icons": {
      "16": "./assets/favicon.png",
      "48": "./assets/favicon.png",
      "128": "./assets/favicon.png"
    }
}
  