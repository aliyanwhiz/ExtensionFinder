{
    "manifest_version": 3,
    "name": "Phone Book",
    "description":"This extension is used to manage company local contact network",
    "version": "7.0.4",
    "action": {
      "default_popup": "Index.html",
      "default_title": "Extension Person Finder"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["./scripts/script.js"]
      }
    ],
    "permissions": [
      "storage"
    ],
    "chrome_url_overrides": {},
    "icons": {
      "16": "./assets/favicon.png",
      "48": "./assets/favicon.png",
      "128": "./assets/favicon.png"
    }
}
  